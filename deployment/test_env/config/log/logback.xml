<configuration>
  <include resource="org/springframework/boot/logging/logback/defaults.xml" />
  <include resource="org/springframework/boot/logging/logback/console-appender.xml" />

  <!-- Everything goes to the container's stdout, where Docker caps it (json-file, 50m x 7)
       and the monitoring agent ships it. -->
  <appender name="ASYNC_CONSOLE" class="ch.qos.logback.classic.AsyncAppender">
    <appender-ref ref="CONSOLE" />
    <queueSize>500</queueSize>
    <discardingThreshold>0</discardingThreshold>
    <includeCallerData>false</includeCallerData>
  </appender>

  <logger name="org.openlmis.auth" level="WARN"/>
  <logger name="org.openlmis.notification" level="WARN"/>
  <logger name="org.openlmis.referencedata" level="WARN"/>
  <logger name="org.openlmis.requisition" level="WARN"/>
  <logger name="org.openlmis.stockmanagement" level="WARN"/>
  <logger name="org.openlmis.fulfillment" level="WARN"/>
  <logger name="org.openlmis.report" level="WARN"/>
  <logger name="org.openlmis.cce" level="WARN"/>
  <logger name="org.openlmis.selv" level="WARN"/>

  <root level="WARN">
    <appender-ref ref="ASYNC_CONSOLE"/>
  </root>
</configuration>
