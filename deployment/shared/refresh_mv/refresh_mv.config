###############################
###### REFRESH MV CONFIG ######
###############################

# Name of the database
DATABASE_NAME=open_lmis

# Container name with the database
POSTGRES_CONTAINER_NAME=postgres_container_name

# Path to the log file
LOG_FILE=/home/ubuntu/refresh_mv/refresh_log.txt

##### STOCKMANAGEMENT SCHEMA MATERIALIZED VIEWS #####

MV_CALCULATED_STOCK_ON_HAND=stockmanagement.mv_calculated_stock_on_hand

MV_COVAX_PHYSICAL_INVENTORIES_REPORTS=stockmanagement.mv_covax_physical_inventories_reports

MV_STOCK_PHYS_INV=stockmanagement.mv_physical_inventories

MV_STOCK_PHYS_INV_LINE_ITEMS=stockmanagement.mv_physical_inventory_line_items

MV_STOCK_CARD_LINE_ITEMS=stockmanagement.mv_stock_card_line_items

##### DASHBOARD SCHEMA MATERIALIZED VIEWS TO REFRESH DAILY #####

MV_FACILITIES=dashboard.mv_facilities

MV_CALCULATED_STOCKS_ON_HAND=dashboard.vw_calculated_stocks_on_hand

MV_CCE_INVENTORY=dashboard.mv_cce_inventory

MV_STOCKS_ON_HAND_BY_LOT=dashboard.mv_stockonhand_by_lot

MV_STOCK_MOVEMENTS=dashboard.mv_stock_movements

MV_STOCK_ON_HAND_CONSUMPTION=dashboard.mv_stockonhand_consumption

MV_STOCK_OUT=dashboard.mv_stock_out

MV_REQUISITION_STATUS=dashboard.mv_requisition_status

MV_REQUISITION_WITH_ITEMS=dashboard.mv_requisition_with_items

MV_REQUISITION_REPORT_RATE=dashboard.mv_requisition_report_rate

##### DASHBOARD SCHEMA MATERIALIZED VIEWS TO REFRESH WEEKLY #####

MV_PHYSICAL_INVENTORIES_REPORT_RATE=dashboard.mv_physical_inventories_report_rate

MV_PHYSICAL_INVENTORIES_STATUS=dashboard.mv_physical_inventories_status

#### MONTHLY REFRESH ####

MV_STOCKOUTS=dashboard.mv_stockouts

