# Per-environment values. The real file is <env>/alloy.env in selv-v3-configuration
# (it carries the ingest token); deploy_alloy.sh copies it here as .env.

DOCKER_HOST=tcp://test.selv.org.mz:2376
# test_env runs Docker 19.03 (API 1.40); newer docker CLIs refuse it unless pinned.
DOCKER_API_VERSION=1.40

# Last Alloy release in Docker image format: from v1.13 the images are OCI-only,
# which Docker 19.03 on test_env cannot pull. Raise it once the host is on 20.10+.
ALLOY_VERSION=v1.12.2

# Keep stable: config.alloy drops the agent's own logs by this project name.
COMPOSE_PROJECT_NAME=soldevelo-monitoring-agents

# Identity labels. environment is the monitoring enum: Test=staging, Prod=prod.
APP=openlmis
DEPLOYMENT=selv
ENVIRONMENT=staging
TARGET_NAME=selv-test

INGEST_METRICS_URL=https://olmis-monitoring.soldevelo.com/ingest/prometheus/api/v1/write
INGEST_LOGS_URL=https://olmis-monitoring.soldevelo.com/ingest/loki/loki/api/v1/push
# Must equal INGEST_TOKEN in the monitoring host's .env. Never commit it here.
INGEST_TOKEN=__set_in_selv_v3_configuration__

# Compose services whose container logs never leave the host.
LOG_DROP_SERVICES=

# postgres_exporter: set COMPOSE_PROFILES=postgres and the DSN of the read-only
# monitoring role (GRANT pg_monitor). The DSN carries a password - selv-v3-configuration only.
COMPOSE_PROFILES=
PG_EXPORTER_DSN=postgresql://olmis_monitoring:__PASSWORD__@<db-host>:5432/open_lmis?sslmode=disable
